# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=iteam
DB_USER=iteam
DB_PASSWORD=iteam

# Used by Prisma CLI (migrations, generate) and the NestJS server at runtime.
# Local dev: point to localhost (Docker db port is exposed on 5434).
# Docker:    docker-compose injects DATABASE_URL with hostname "db" automatically
#            — this value is not read inside containers.
DATABASE_URL=postgresql://iteam:iteam@localhost:5434/iteam?schema=public

# ── Exposed host ports (optional — defaults shown) ────────────────────────────
CLIENT_PORT=3000
SERVER_PORT=4000
