generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// #Enums

enum Role {
  USER
  ADMIN
}

enum NotifType {
  ONBOARDING_START
  ONBOARDING_END
  PASSWORD_RESET // after user's password is reset
  JOB_ASSIGNED // when a user is assigned to a specific job
}

enum WorkDayStatus {
  WORKING
  WEEKEND_PAID
  WEEKEND_UNPAID
  SICK_LEAVE_UNPAID
  SICK_LEAVE_PAID
  VACATION
}

// #Models

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  fullName   String
  phone      String?
  dob        DateTime?
  occupation String?
  salary     Decimal?  @db.Decimal(12, 2)
  role       Role      @default(USER)

  resetToken       String?
  resetTokenExpiry DateTime?

  // Status / working-on
  statusNote       String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?

  notifications    Notification[]
  workDays         WorkDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          Int     @id @default(autoincrement())
  title       String
  logo        String?
  description String?

  users    User[]
  roles    CompanyRole[]
  settings CompanySettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int     @unique

  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRole {
  id        Int     @id @default(autoincrement())
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  createdAt DateTime @default(now())

  @@unique([name, companyId])
}

model Notification {
  id     Int       @id @default(autoincrement())
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  type   NotifType
  title  String
  body   String?
  read   Boolean   @default(false)

  createdAt DateTime @default(now())
}

model WorkDay {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime      @db.Date
  status    WorkDayStatus @default(WORKING)
  startTime String?
  endTime   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
