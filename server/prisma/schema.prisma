generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// #Enums

enum NotifType {
  ONBOARDING_START
  ONBOARDING_END
  PASSWORD_RESET // after user's password is reset
  JOB_ASSIGNED // when a user is assigned to a specific job
}

enum WorkDayStatus {
  WEEKEND_PAID
  WEEKEND_UNPAID
  SICK_LEAVE_UNPAID
  SICK_LEAVE_PAID
  VACATION
  HOLIDAY
}

enum ProjectRole {
  HOLDER // owns the project
  HELPER // helps on the project
}

enum CompanyPermission {
  ADMIN
  MANAGE_COMPANY
  MANAGE_SETTINGS
  MANAGE_ROLES
  MANAGE_MEMBERS
  MANAGE_SALARY
  INVITE_MEMBERS
  SEND_MESSAGES
}

// #Models

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  fullName   String
  phone      String?
  dob        DateTime?
  occupation String?
  salary     Decimal?  @db.Decimal(12, 2)

  resetToken       String?
  resetTokenExpiry DateTime?

  // Status / working-on
  statusNote       String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?

  companyRole   CompanyRole? @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)
  companyRoleId Int?

  notifications    Notification[]
  workDays         WorkDay[]
  workEntries      WorkTimeEntry[]
  sessions         Session[]
  projects         ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Company {
  id          Int     @id @default(autoincrement())
  title       String
  logo        String?
  description String?

  users    User[]
  roles    CompanyRole[]
  settings CompanySettings?
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int     @unique

  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRole {
  id          Int                 @id @default(autoincrement())
  name        String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   Int
  permissions CompanyPermission[] @default([])
  members     User[]

  createdAt DateTime @default(now())

  @@unique([name, companyId])
}

model Notification {
  id     Int       @id @default(autoincrement())
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  type   NotifType
  title  String
  body   String?
  read   Boolean   @default(false)

  createdAt DateTime @default(now())
}

model WorkDay {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime      @db.Date
  status    WorkDayStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Project {
  id      Int     @id @default(autoincrement())
  name    String
  country String?
  hours   Int? // null = fixed price

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  members ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// Join table between Project and User. The composite id means a person is
/// either a HOLDER or a HELPER on a given project, never both — that is what
/// keeps the projects graph a tree.
model ProjectMember {
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  role      ProjectRole @default(HELPER)
  addedAt   DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model WorkTimeEntry {
  id            Int           @id @default(autoincrement())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  // project       Project?
  description   String?
  date          DateTime      @db.Date
  startTime     String?
  endTime       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
