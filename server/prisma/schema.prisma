generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// #Enums

enum NotifType {
  ONBOARDING_START
  ONBOARDING_END
  PASSWORD_RESET // after user's password is reset
  JOB_ASSIGNED // when a user is assigned to a specific job
}

enum WorkDayStatus {
  WEEKEND_PAID
  WEEKEND_UNPAID
  SICK_LEAVE_UNPAID
  SICK_LEAVE_PAID
  VACATION
  HOLIDAY
}

enum ProjectRole {
  HOLDER // owns the project
  HELPER // helps on the project
}

enum FinanceSheetKind {
  TEMPLATE // the reusable skeleton a new month is cloned from
  MONTH
}

enum FinanceNodeKind {
  DESTINATION
  INCOME
  NOTE
}

enum FinanceDestinationType {
  PAYPAL
  PAYONEER
  BANK_FOP // FOP bank account (Ukraine)
  OTHER // free-form, uses `label`
}

enum FinanceIncomeStatus {
  NOT_TRANSFERRED
  PENDING
  TRANSFERRED
}

enum CompanyPermission {
  ADMIN
  MANAGE_COMPANY
  MANAGE_SETTINGS
  MANAGE_ROLES
  MANAGE_MEMBERS
  MANAGE_SALARY
  INVITE_MEMBERS
  SEND_MESSAGES
}

// #Models

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  fullName   String
  phone      String?
  dob        DateTime?
  occupation String?
  salary     Decimal?  @db.Decimal(12, 2)

  resetToken       String?
  resetTokenExpiry DateTime?

  // Status / working-on
  statusNote String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?

  companyRole   CompanyRole? @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)
  companyRoleId Int?

  notifications Notification[]
  workDays      WorkDay[]
  workEntries   WorkTimeEntry[]
  sessions      Session[]
  projects      ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Company {
  id          Int     @id @default(autoincrement())
  title       String
  logo        String?
  description String?

  users         User[]
  roles         CompanyRole[]
  settings      CompanySettings?
  projects      Project[]
  financeSheets FinanceSheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int     @unique

  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRole {
  id          Int                 @id @default(autoincrement())
  name        String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   Int
  permissions CompanyPermission[] @default([])
  members     User[]

  createdAt DateTime @default(now())

  @@unique([name, companyId])
}

model Notification {
  id     Int       @id @default(autoincrement())
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  type   NotifType
  title  String
  body   String?
  read   Boolean   @default(false)

  createdAt DateTime @default(now())
}

model WorkDay {
  id     Int           @id @default(autoincrement())
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  date   DateTime      @db.Date
  status WorkDayStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Project {
  id      Int     @id @default(autoincrement())
  name    String
  country String?
  hours   Int? // null = fixed price

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  members      ProjectMember[]
  financeNodes FinanceNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// Join table between Project and User. The composite id means a person is
/// either a HOLDER or a HELPER on a given project, never both — that is what
/// keeps the projects graph a tree.
model ProjectMember {
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  role      ProjectRole @default(HELPER)
  addedAt   DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// One month of money movement, drawn as a diagram. The TEMPLATE sheet holds
/// the skeleton (destinations, recurring income sources, notes and their
/// layout) that "new month" clones so nothing is refilled from scratch.
model FinanceSheet {
  id        Int              @id @default(autoincrement())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int
  kind      FinanceSheetKind @default(MONTH)
  /// Both null on the TEMPLATE sheet.
  year      Int?
  month     Int? // 1-12

  nodes FinanceNode[]
  edges FinanceEdge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Keeps a month unique per company. Postgres treats NULLs as distinct, so
  /// this does not constrain TEMPLATE rows — the service enforces one template
  /// per company instead.
  @@unique([companyId, year, month])
  @@index([companyId])
}

/// One box on a sheet. Single table with a `kind` discriminator so positions
/// and edges can reference any box by one id; the service validates that only
/// the fields belonging to `kind` are set.
model FinanceNode {
  id      Int             @id @default(autoincrement())
  sheet   FinanceSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sheetId Int
  kind    FinanceNodeKind

  // Canvas position — this board is arranged by hand, so it is persisted.
  x Float @default(0)
  y Float @default(0)

  // DESTINATION
  destinationType FinanceDestinationType?

  // DESTINATION: custom name when type is OTHER.
  // INCOME: snapshot of the project name so the box still reads correctly if
  // the project is later deleted.
  label String?

  // INCOME
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?
  amount    Decimal?             @db.Decimal(12, 2)
  currency  String?              @db.VarChar(3)
  /// Exact date when `dateTo` is null, otherwise the start of the range.
  dateFrom  DateTime?            @db.Date
  dateTo    DateTime?            @db.Date
  status    FinanceIncomeStatus?

  // NOTE
  text String?

  outgoing FinanceEdge[] @relation("FinanceEdgeSource")
  incoming FinanceEdge[] @relation("FinanceEdgeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sheetId])
  @@index([projectId])
}

/// A hand-drawn money flow, normally income source -> destination.
model FinanceEdge {
  id       Int          @id @default(autoincrement())
  sheet    FinanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sheetId  Int
  source   FinanceNode  @relation("FinanceEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId Int
  target   FinanceNode  @relation("FinanceEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId Int

  createdAt DateTime @default(now())

  @@unique([sourceId, targetId])
  @@index([sheetId])
}

model WorkTimeEntry {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  // project       Project?
  description String?
  date        DateTime @db.Date
  startTime   String?
  endTime     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
