generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum BoardType {
  LIST
  KANBAN
  SCRUM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEstimate {
  S
  M
  L
  XL
}

enum NotifType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_UPDATED
}

enum WorkDayStatus {
  WORKING
  WEEKEND
  SICK_LEAVE
  VACATION
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  fullName   String
  phone      String?
  dob        DateTime?
  occupation String?
  salary     Decimal?  @db.Decimal(12, 2)
  role       Role      @default(USER)

  resetToken       String?
  resetTokenExpiry DateTime?

  // Status / working-on
  workingOnTask    Task?    @relation("WorkingOnTask", fields: [workingOnTaskId], references: [id], onDelete: SetNull)
  workingOnTaskId  Int?
  statusNote       String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?

  boardsCreated    Board[]        @relation("BoardCreatedBy")
  tasksCreated     Task[]         @relation("TaskCreatedBy")
  taskAssignments  TaskAssignee[]
  notifications    Notification[]
  workDays         WorkDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          Int     @id @default(autoincrement())
  title       String
  logo        String?
  description String?

  users    User[]
  roles    CompanyRole[]
  settings CompanySettings?
  boards   Board[]
  tasks    Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int     @unique

  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRole {
  id        Int     @id @default(autoincrement())
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  createdAt DateTime @default(now())

  @@unique([name, companyId])
}

model Board {
  id          Int       @id @default(autoincrement())
  title       String
  type        BoardType @default(KANBAN)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   Int
  createdBy   User      @relation("BoardCreatedBy", fields: [createdById], references: [id])
  createdById Int

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  estimate      TaskEstimate?
  estimateHours Float?
  startDate     DateTime?
  endDate       DateTime?

  board         Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId       Int
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     Int
  createdBy     User    @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById   Int

  assignees     TaskAssignee[]
  notifications Notification[]
  workingOnBy   User[]         @relation("WorkingOnTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskAssignee {
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
}

model Notification {
  id     Int       @id @default(autoincrement())
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  type   NotifType
  title  String
  body   String?
  read   Boolean   @default(false)
  task   Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId Int?

  createdAt DateTime @default(now())
}

model WorkDay {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime      @db.Date
  status    WorkDayStatus @default(WORKING)
  startTime String?
  endTime   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
